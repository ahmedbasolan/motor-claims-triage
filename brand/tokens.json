{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Motor Claims Triage — Dossier",
  "version": "1.0.0",
  "description": "Three-layer design tokens. Primitive raw values -> semantic purpose aliases -> component tokens. Never reference primitives from app code; always use semantic or component tokens.",

  "primitive": {
    "color": {
      "paper": {
        "50":  { "$value": "#FDFAF4", "$type": "color", "$description": "Lifted surface (cards on paper)" },
        "100": { "$value": "#F7F1E6", "$type": "color", "$description": "App background — warm paper" },
        "200": { "$value": "#F0E8D9", "$type": "color", "$description": "Recessed surface (sidebar, sunken panels)" },
        "300": { "$value": "#E6DCC8", "$type": "color", "$description": "Strong border / kraft" },
        "400": { "$value": "#D9CDB5", "$type": "color", "$description": "Kraft accent, table header fill" }
      },
      "ink": {
        "900": { "$value": "#1F1B16", "$type": "color", "$description": "Primary text — warm near-black, never pure #000" },
        "700": { "$value": "#3A342C", "$type": "color", "$description": "Secondary text" },
        "500": { "$value": "#6E6558", "$type": "color", "$description": "Muted text" },
        "400": { "$value": "#8F8574", "$type": "color", "$description": "Tertiary / disabled text" },
        "300": { "$value": "#B5AB99", "$type": "color", "$description": "Placeholder" }
      },
      "archival": {
        "700": { "$value": "#1E3A32", "$type": "color", "$description": "Archival green — pressed / strongest" },
        "600": { "$value": "#2C4F43", "$type": "color", "$description": "Archival green — primary brand" },
        "500": { "$value": "#3D6759", "$type": "color", "$description": "Archival green — hover" },
        "100": { "$value": "#DCE7E1", "$type": "color", "$description": "Archival green tint" }
      },
      "oxblood": {
        "700": { "$value": "#6E2430", "$type": "color", "$description": "Oxblood — pressed / text-on-tint" },
        "600": { "$value": "#8C2F39", "$type": "color", "$description": "Oxblood — rubber-stamp red, investigate" },
        "100": { "$value": "#F3E0E2", "$type": "color", "$description": "Oxblood tint" }
      },
      "ochre": {
        "700": { "$value": "#7A5E2A", "$type": "color", "$description": "Ochre — text-on-tint (passes 4.5:1 on tint and paper)" },
        "600": { "$value": "#9A7B3F", "$type": "color", "$description": "Ochre — caution, standard review (borders/fills; use 700 for text)" },
        "100": { "$value": "#F0E6D0", "$type": "color", "$description": "Ochre tint" }
      },
      "white-warm": { "$value": "#FBF8F1", "$type": "color", "$description": "On-primary text — warm white, never pure #FFF" }
    },

    "font": {
      "family": {
        "display": { "$value": "'Source Serif 4', Georgia, serif", "$type": "fontFamily", "$description": "Headings, wordmark, editorial voice" },
        "body":    { "$value": "'IBM Plex Sans', system-ui, sans-serif", "$type": "fontFamily", "$description": "UI body text" },
        "mono":    { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$type": "fontFamily", "$description": "Claim IDs, policy numbers, AED amounts, dates, scores" }
      },
      "size": {
        "2xs": { "$value": "11px", "$type": "dimension" },
        "xs":  { "$value": "12px", "$type": "dimension" },
        "sm":  { "$value": "13px", "$type": "dimension" },
        "md":  { "$value": "15px", "$type": "dimension", "$description": "Body — dense dashboard default" },
        "lg":  { "$value": "17px", "$type": "dimension" },
        "xl":  { "$value": "21px", "$type": "dimension" },
        "2xl": { "$value": "28px", "$type": "dimension" },
        "3xl": { "$value": "36px", "$type": "dimension" }
      },
      "weight": {
        "regular":  { "$value": 400, "$type": "fontWeight" },
        "medium":   { "$value": 500, "$type": "fontWeight" },
        "semibold": { "$value": 600, "$type": "fontWeight" },
        "bold":     { "$value": 700, "$type": "fontWeight" }
      },
      "tracking": {
        "eyebrow": { "$value": "0.14em", "$type": "dimension", "$description": "Small-caps section labels" },
        "stamp":   { "$value": "0.16em", "$type": "dimension", "$description": "Stamp badges" }
      },
      "lineHeight": {
        "tight":  { "$value": 1.2, "$type": "number" },
        "normal": { "$value": 1.5, "$type": "number" },
        "loose":  { "$value": 1.65, "$type": "number" }
      }
    },

    "space": {
      "1":  { "$value": "4px",  "$type": "dimension" },
      "2":  { "$value": "8px",  "$type": "dimension" },
      "3":  { "$value": "12px", "$type": "dimension" },
      "4":  { "$value": "16px", "$type": "dimension" },
      "5":  { "$value": "24px", "$type": "dimension" },
      "6":  { "$value": "32px", "$type": "dimension" },
      "7":  { "$value": "48px", "$type": "dimension" },
      "8":  { "$value": "64px", "$type": "dimension" }
    },

    "radius": {
      "sm":   { "$value": "2px", "$type": "dimension", "$description": "Inputs, chips" },
      "md":   { "$value": "3px", "$type": "dimension", "$description": "Cards, buttons — absolute max for structure" },
      "none": { "$value": "0px", "$type": "dimension", "$description": "Stamps, tables, rules" }
    },

    "border": {
      "hairline": { "$value": "1px", "$type": "dimension" },
      "stamp":    { "$value": "1.75px", "$type": "dimension" }
    },

    "shadow": {
      "paper": { "$value": "0 1px 2px rgba(31, 27, 22, 0.05), 0 1px 1px rgba(31, 27, 22, 0.04)", "$type": "shadow", "$description": "Only permitted shadow — warm-tinted, barely there" }
    },

    "motion": {
      "fast":  { "$value": "120ms", "$type": "duration" },
      "base":  { "$value": "180ms", "$type": "duration" },
      "ease":  { "$value": "ease", "$type": "cubicBezier" }
    }
  },

  "semantic": {
    "color": {
      "bg-app":        { "$value": "{primitive.color.paper.100}", "$type": "color" },
      "bg-surface":    { "$value": "{primitive.color.paper.50}",  "$type": "color", "$description": "Cards, main panels" },
      "bg-sunken":     { "$value": "{primitive.color.paper.200}", "$type": "color", "$description": "Sidebar, inset areas, table header" },
      "bg-overlay":    { "$value": "rgba(31, 27, 22, 0.35)", "$type": "color" },

      "fg-default":    { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "fg-secondary":  { "$value": "{primitive.color.ink.700}", "$type": "color" },
      "fg-muted":      { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "fg-disabled":   { "$value": "{primitive.color.ink.400}", "$type": "color" },
      "fg-on-primary": { "$value": "{primitive.color.white-warm}", "$type": "color" },

      "border-default": { "$value": "#E3D8C4", "$type": "color", "$description": "Hairline rules, card borders" },
      "border-strong":  { "$value": "{primitive.color.paper.300}", "$type": "color" },

      "primary":        { "$value": "{primitive.color.archival.600}", "$type": "color" },
      "primary-hover":  { "$value": "{primitive.color.archival.500}", "$type": "color" },
      "primary-active": { "$value": "{primitive.color.archival.700}", "$type": "color" },

      "status-pass":       { "$value": "{primitive.color.archival.600}", "$type": "color", "$description": "Fast-track, coverage clear" },
      "status-pass-tint":  { "$value": "{primitive.color.archival.100}", "$type": "color" },
      "status-pass-ink":   { "$value": "{primitive.color.archival.700}", "$type": "color" },

      "status-caution":      { "$value": "{primitive.color.ochre.600}", "$type": "color", "$description": "Standard review — use ochre.700 for text" },
      "status-caution-tint": { "$value": "{primitive.color.ochre.100}", "$type": "color" },
      "status-caution-ink":  { "$value": "{primitive.color.ochre.700}", "$type": "color" },

      "status-danger":      { "$value": "{primitive.color.oxblood.600}", "$type": "color", "$description": "Investigate, exclusions, hard fails" },
      "status-danger-tint": { "$value": "{primitive.color.oxblood.100}", "$type": "color" },
      "status-danger-ink":  { "$value": "{primitive.color.oxblood.700}", "$type": "color" },

      "focus-ring": { "$value": "{primitive.color.archival.600}", "$type": "color" }
    },

    "font": {
      "heading": { "$value": "{primitive.font.family.display}", "$type": "fontFamily" },
      "body":    { "$value": "{primitive.font.family.body}",    "$type": "fontFamily" },
      "data":    { "$value": "{primitive.font.family.mono}",    "$type": "fontFamily" }
    }
  },

  "component": {
    "button": {
      "primary": {
        "bg":          { "$value": "{semantic.color.primary}", "$type": "color" },
        "bg-hover":    { "$value": "{semantic.color.primary-hover}", "$type": "color" },
        "bg-active":   { "$value": "{semantic.color.primary-active}", "$type": "color" },
        "fg":          { "$value": "{semantic.color.fg-on-primary}", "$type": "color" },
        "radius":      { "$value": "{primitive.radius.md}", "$type": "dimension" },
        "padding-x":   { "$value": "{primitive.space.4}", "$type": "dimension" },
        "padding-y":   { "$value": "{primitive.space.2}", "$type": "dimension" }
      }
    },

    "stamp": {
      "$description": "Signature component. Square, oxblood/pass/caution ink, uppercase, tracked out, slight counter-clockwise rotation. Reserved for triage verdicts and hard coverage outcomes — never decorative.",
      "border-width": { "$value": "{primitive.border.stamp}", "$type": "dimension" },
      "radius":       { "$value": "{primitive.radius.none}", "$type": "dimension" },
      "tracking":     { "$value": "{primitive.font.tracking.stamp}", "$type": "dimension" },
      "rotate":       { "$value": "-1.2deg", "$type": "string" },
      "font-size":    { "$value": "{primitive.font.size.xl}", "$type": "dimension" },
      "padding-x":    { "$value": "{primitive.space.4}", "$type": "dimension" },
      "padding-y":    { "$value": "{primitive.space.2}", "$type": "dimension" }
    },

    "card": {
      "bg":       { "$value": "{semantic.color.bg-surface}", "$type": "color" },
      "border":   { "$value": "{semantic.color.border-default}", "$type": "color" },
      "radius":   { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "shadow":   { "$value": "{primitive.shadow.paper}", "$type": "shadow" },
      "padding":  { "$value": "{primitive.space.4}", "$type": "dimension" }
    },

    "chip": {
      "$description": "Small status/level chips. Tinted background, ink text from the same family.",
      "radius":     { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "font-size":  { "$value": "{primitive.font.size.2xs}", "$type": "dimension" },
      "tracking":   { "$value": "{primitive.font.tracking.eyebrow}", "$type": "dimension" },
      "padding-x":  { "$value": "{primitive.space.2}", "$type": "dimension" },
      "padding-y":  { "$value": "3px", "$type": "dimension" }
    },

    "alert": {
      "$description": "Inline notes. Tinted paper background, 3px left rule in the status ink, no icon balloons.",
      "radius":   { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "rule":     { "$value": "3px", "$type": "dimension" },
      "padding":  { "$value": "{primitive.space.3} {primitive.space.4}", "$type": "string" }
    },

    "table": {
      "header-bg":   { "$value": "{semantic.color.bg-sunken}", "$type": "color" },
      "header-fg":   { "$value": "{semantic.color.fg-secondary}", "$type": "color" },
      "row-alt-bg":  { "$value": "{primitive.color.paper.50}", "$type": "color" },
      "cell-font":   { "$value": "{semantic.font.data}", "$type": "fontFamily" },
      "cell-size":   { "$value": "{primitive.font.size.sm}", "$type": "dimension" }
    },

    "input": {
      "bg":       { "$value": "{semantic.color.bg-surface}", "$type": "color" },
      "border":   { "$value": "{semantic.color.border-strong}", "$type": "color" },
      "radius":   { "$value": "{primitive.radius.sm}", "$type": "dimension" },
      "font":     { "$value": "{semantic.font.body}", "$type": "fontFamily" }
    }
  }
}
